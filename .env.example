APPLICATION_HOST=0.0.0.0

MYSQL_DB=ms-image
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PW=
# Optional external HD integration; keep disabled for the Runtime default.
MYSQL_HD_ENABLED=false

LOG_PATH=/Users/mozhicheng/workspace/logs
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
ENV=dev
AUTH_DOMAIN=http://localhost:3011
# Runtime API accepts Basic Auth only when both credentials are configured.
# Inject the password through the deployment Secret mechanism; do not commit it.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
BASIC_AUTH_SUBJECT=ms-image-basic-user
BASIC_AUTH_SCOPES=imaging:run
GUNICORN_ERROR_LOG_PATH="/www/wwwlogs/vet-platform-log"
RABBITMQ_HOST=localhost
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_VIRTUAL_HOST=/
PROJECT_ENV=development

ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
ALIYUN_OSS_BUCKET=ms-sz
ALIYUN_OSS_BASE_URL=https://petaicare-dev.oss-cn-shenzhen.aliyuncs.com/
ALIYUN_ROLE_ARN=acs:ram::1190678214187585:role/ossreadonlyrole
ALIYUN_ROLE_SESSION_NAME=OssReadOnlyRole
ALIYUN_STS_DURATION_SECONDS=300
ALIYUN_STS_ACCESS_KEY_ID=
ALIYUN_STS_ACCESS_KEY_SECRET=

# ms-ai-platform OpenAI-compatible endpoint; both values are required for AI calls.
# Inject non-empty values only through the API/Worker deployment environment.
AI_PLATFORM_OPENAI_BASE_URL=
AI_PLATFORM_API_KEY=
AI_PLATFORM_TIMEOUT_SECONDS=120
XRAY_TARGETED_EXPERIMENT_SCOPE_KEY=

UVICORN_WORKERS=5
# 日志级别
UVICORN_LOG_LEVEL=info
# 是否开启热重载（开启reload时只能用单worker）
UVICORN_RELOAD=false

# Celery Worker 配置
CELERY_WORKER_POOL=prefork
# 默认保持每个队列单并发、每进程预取一条；如需扩容，优先增加 Worker 副本。
IMAGING_WORKER_CONCURRENCY=1
EVALUATION_WORKER_CONCURRENCY=1
# AI Attempt reconcile scheduler ownership. Keep disabled unless this exact
# deployment owns the single Celery Beat process; do not combine with an
# external CronJob/platform scheduler for the same task.
AI_ATTEMPT_RECONCILE_SCHEDULE_ENABLED=false
AI_ATTEMPT_RECONCILE_INTERVAL_SECONDS=60
AI_ATTEMPT_RECONCILE_BATCH_LIMIT=50
AI_ATTEMPT_RECONCILE_POLICY_VERSION=ai-attempt-reconcile.v1
AI_ATTEMPT_RECONCILE_MAX_COUNT=3
AI_ATTEMPT_RECONCILE_MAX_UNKNOWN_AGE_SECONDS=10800
AI_ATTEMPT_RECONCILE_LEASE_SECONDS=120
AI_ATTEMPT_RECONCILE_RETRY_SECONDS=300
# ==================== Week1: AI智能路由配置 ====================
# 智能路由开关（设置为true启用智能API选择）
ENABLE_SMART_API_ROUTING=false

# 请求分类阈值 - 文本（3000以下为小，3000以上为大）
API_PROMPT_LENGTH_SMALL=3000
API_PROMPT_LENGTH_MEDIUM=3000

# 请求分类阈值 - 文档
API_PDF_PAGES_SMALL=5
API_PDF_PAGES_MEDIUM=20
API_WORD_PAGES_SMALL=10
API_WORD_PAGES_MEDIUM=30

# API选择配置
API_MIN_SUCCESS_RATE=0.5
API_SCORE_WEIGHT_SUCCESS=0.4
API_SCORE_WEIGHT_SPEED=0.3
API_SCORE_WEIGHT_STABILITY=0.2
API_SCORE_WEIGHT_COST=0.1

# 冷启动保护
API_COLD_START_THRESHOLD=10
API_COLD_START_BOOST=0.75

# 分层选择概率
API_LAYER1_PROB=0.5
API_LAYER2_PROB=0.4
API_LAYER3_PROB=0.1

# ==================== Prompt评估队列配置 ====================
# Prompt质量评估开关（启用后，所有AI请求都会异步进入评估队列进行质量分析）
PROMPT_EVALUATION_ENABLED=false
# 评估队列路由键
PROMPT_EVALUATION_ROUTING_KEY=prompt.evaluation.quality

# ========================================
# LLM 竞速模式配置
# ========================================
LLM_RACE_MODE_ENABLED=true

# ========================================
# X光网格智能分析配置
# ========================================
# 是否启用网格预分析功能（启用后会使用本地CNN模型或外部API进行预分析）
ENABLE_GRID_PRE_ANALYSIS=false
# AI配置缓存（关闭以便开发调试）
AI_CONFIG_CACHE_ENABLED=true

# Phase 2A Runtime operational alert thresholds; set a threshold to 0 to disable that rule.
OPERATIONAL_ALERTS_ENABLED=true
OPERATIONAL_ALERT_LEASE_COUNT_THRESHOLD=1
OPERATIONAL_ALERT_ACTIVE_AGE_SECONDS=300
OPERATIONAL_ALERT_AI_UNKNOWN_AGE_SECONDS=300
OPERATIONAL_ALERT_QUEUE_DEPTH=100
OPERATIONAL_ALERT_DLQ_DEPTH=1
OPERATIONAL_ALERT_CONSUMER_MINIMUM=1
OPERATIONAL_ALERT_MISSING_ROWS=1
OPERATIONAL_ALERT_INVALID_COMPARISONS=1
OPERATIONAL_ALERT_COVERAGE_LOSS=1
OPERATIONAL_ALERT_TECHNICAL_FAILURES=1
OPERATIONAL_ALERT_ARTIFACT_DRIFT=1

APPLICATION_NAME=MS-Async-AI
APPLICATION_PORT=8000

# ========================================
# 器官分割配置
# ========================================
# 器官分割功能总开关
ORGAN_SEG_ENABLED=true
# 器官分割结果 Redis 缓存时间（秒）
ORGAN_SEG_REDIS_TTL=1800
# 多视图拼接片检测开关
MULTI_VIEW_DETECTION_ENABLED=true
# 多视图检测强度阈值（0-255，越低越敏感）
MULTI_VIEW_INTENSITY_THRESHOLD=30

# ========================================
# 器官分割裁剪存储配置
# ========================================
# 裁剪图上传 OSS 存 URL（True）还是用 base64 data URI（False）
# 必须设为 True，否则 base64 数据会导致融合诊断 prompt 爆炸（50MB+）
ORGAN_SEG_CROP_UPLOAD_OSS=True
# 裁剪图 base64 编码格式（仅 ORGAN_SEG_CROP_UPLOAD_OSS=false 时生效）
ORGAN_SEG_CROP_BASE64_FORMAT=png
# 裁剪图 JPEG 质量（仅 ORGAN_SEG_CROP_BASE64_FORMAT=jpeg 时生效）
ORGAN_SEG_CROP_JPEG_QUALITY=90
