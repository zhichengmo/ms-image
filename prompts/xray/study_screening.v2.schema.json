{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XRayStudyScreeningProviderV2",
  "x-ms-image-contract-version": "xray-study-screening-provider.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "species",
    "study_quality_status",
    "coverage_summary",
    "technical_limitations",
    "emergency_signals",
    "screening_findings",
    "families_requiring_analysis",
    "families_not_assessed",
    "source_refs"
  ],
  "$defs": {
    "family_key": {
      "type": "string",
      "enum": [
        "thoracic",
        "abdominal",
        "head_neck",
        "axial_orthopedic",
        "appendicular_orthopedic",
        "multisystem",
        "other"
      ]
    },
    "source_ref_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "xray-study-screening-provider.v2"
    },
    "species": {
      "type": "string",
      "enum": [
        "cat",
        "dog"
      ]
    },
    "study_quality_status": {
      "type": "string",
      "enum": [
        "diagnostic",
        "limited",
        "non_diagnostic"
      ]
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_adequacy",
        "summary",
        "assessed_families"
      ],
      "properties": {
        "view_adequacy": {
          "type": "string",
          "enum": [
            "adequate",
            "limited",
            "insufficient"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "assessed_families": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/family_key"
          }
        }
      }
    },
    "technical_limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limitation_id",
          "description",
          "affected_families",
          "source_ref_ids"
        ],
        "properties": {
          "limitation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "affected_families": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/family_key"
            }
          },
          "source_ref_ids": {
            "$ref": "#/$defs/source_ref_ids"
          }
        }
      }
    },
    "emergency_signals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_id",
          "family_key",
          "label",
          "description",
          "urgency",
          "alternative_explanations",
          "source_ref_ids"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "family_key": {
            "$ref": "#/$defs/family_key"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "urgency": {
            "type": "string",
            "enum": [
              "immediate",
              "urgent"
            ]
          },
          "alternative_explanations": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "source_ref_ids": {
            "$ref": "#/$defs/source_ref_ids"
          }
        }
      }
    },
    "screening_findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "family_key",
          "label",
          "description",
          "screening_disposition",
          "source_ref_ids"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "family_key": {
            "$ref": "#/$defs/family_key"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "screening_disposition": {
            "type": "string",
            "enum": [
              "requires_analysis",
              "indeterminate"
            ]
          },
          "source_ref_ids": {
            "$ref": "#/$defs/source_ref_ids"
          }
        }
      }
    },
    "families_requiring_analysis": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family_key"
      }
    },
    "families_not_assessed": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family_key"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref_id",
          "image_id"
        ],
        "properties": {
          "source_ref_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "image_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  }
}
